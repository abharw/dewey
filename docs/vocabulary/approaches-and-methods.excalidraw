      "boundElements": [],
      "updated": 1791769596798,
      "created": 1791769596728,
      "link": null,
      "locked": false,
      "text": "Methods are techniques that can be used across any of these approaches.\nNo approach owns a method.",
      "fontSize": 24,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Methods are techniques that can be used across any of these approaches.\nNo approach owns a method.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SNKLq5FnkA8A6VVzeGdhi",
      "type": "text",
      "x": 72,
      "y": 895,
      "width": 815.2494000000012,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2G",
      "roundness": null,
      "seed": 1327112777,
      "version": 3,
      "versionNonce": 1471561957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791769596798,
      "created": 1791769596728,
      "link": null,
      "locked": false,
      "text": "An analogy can explain an idea, prompt Socratic questions, or guide an experiment.\nApproaches can blend and change within one interaction.",
      "fontSize": 21,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An analogy can explain an idea, prompt Socratic questions, or guide an experiment.\nApproaches can blend and change within one interaction.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

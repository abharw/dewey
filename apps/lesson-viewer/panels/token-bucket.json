{
  "version": 1,
  "tabs": [
    {
      "id": "controls",
      "label": "Controls",
      "spec": {
        "root": "e0",
        "elements": {
          "e0": {
            "type": "Stack",
            "props": {},
            "children": [
              "e1",
              "e5",
              "e11",
              "e12"
            ]
          },

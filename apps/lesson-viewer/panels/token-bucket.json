    },
    {
      "id": "explanation",
      "label": "Explanation",
      "spec": {
        "root": "e0",
        "elements": {
          "e0": {
            "type": "Stack",
            "props": {},
            "children": [
              "e1",
              "e2",
              "e3"
            ]
          },
          "e1": {
            "type": "Text",
            "props": {
              "text": "The bucket holds 20 tokens and refills at 5 tokens per second. Each accepted request spends one token.",
              "tone": "muted"
            },
            "children": []
          },
          "e2": {
            "type": "Text",
            "props": {
              "text": "With fewer than one token, a request is rejected immediately. Requests are never queued. Refilling stops at capacity.",
              "tone": "muted"
            },
            "children": []
          },
          "e3": {
            "type": "Equation",
            "props": {
              "text": "Empty \u2192 full in 4 seconds"
            },
            "children": []
          }
        }
      }
    },
    {
      "id": "try-it",
      "label": "Try it",
      "spec": {
        "root": "e0",
        "elements": {
          "e0": {
            "type": "Stack",
            "props": {},
            "children": [
              "e1"
            ]
          },
          "e1": {
            "type": "Section",
            "props": {
              "title": "Send more than the bucket holds"
            },
            "children": [
              "e2",
              "e3",
              "e5"
            ]
          },
          "e2": {
            "type": "Text",
            "props": {
              "text": "Start full and send 25 requests at once. Predict how many will pass.",
              "tone": "muted"
            },
            "children": []
          },
          "e3": {
            "type": "ActionRow",
            "props": {},
            "children": [
              "e4"
            ]
          },
          "e4": {
            "type": "Button",
            "props": {
              "label": "Try a burst of 25",
              "variant": "primary"
            },
            "on": {
              "press": {
                "action": "invoke",
                "params": {
                  "name": "tryBurst"
                }
              }
            },
            "children": []
          },
          "e5": {
            "type": "Status",
            "props": {
              "text": {
                "$state": "/result"
              }
            },
            "children": []
          }
        }
      }
    }

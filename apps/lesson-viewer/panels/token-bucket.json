          "e12": {
            "type": "Section",
            "props": {},
            "children": [
              "e13",
              "e14"
            ]
          },
          "e13": {
            "type": "Text",
            "props": {
              "text": {
                "$state": "/mode"
              },
              "tone": "muted"
            },
            "children": []
          },
          "e14": {
            "type": "ActionRow",
            "props": {},
            "children": [
              "e15",
              "e16",
              "e17"
            ]
          },
